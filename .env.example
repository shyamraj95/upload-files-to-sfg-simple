# ==============================================================================
# Oracle to IBM Sterling File Gateway (SFG) Exporter - Environment Variables
# Copy to .env for local testing or export via systemd / Kubernetes Secrets / Vault.
# NEVER commit real secrets or private keys into source control.
# ==============================================================================

# --- Oracle Database Connection (Required) ---
ORACLE_DB_URL=jdbc:oracle:thin:@//oracle-db.internal.corp:1521/ORCLPDB1
ORACLE_DB_USER=sfg_export_ro
ORACLE_DB_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD

# --- Local Storage Directories & Retention ---
APP_STAGING_DIR=/var/app/sfg-exporter/staging
APP_BACKUP_DIR=/var/app/sfg-exporter/backup
APP_BACKUP_RETENTION_DAYS=15

# --- Primary IBM SFG SFTP Target (SSH Private Key Auth - Preferred) ---
SFG_PRIMARY_HOST=sfg-prod.internal.corp
SFG_PRIMARY_PORT=22
SFG_PRIMARY_USER=svc_gl_exporter
SFG_SSH_KEY_PATH=/etc/sfg-exporter/keys/sfg_ed25519
SFG_SSH_KEY_PASSPHRASE=CHANGE_ME_KEY_PASSPHRASE
SFG_KNOWN_HOSTS_PATH=/etc/sfg-exporter/keys/known_hosts

# --- Secondary IBM SFG SFTP Target (Password Auth Fallback Example) ---
SFG_SECONDARY_HOST=sfg-partner.internal.corp
SFG_SECONDARY_PORT=2222
SFG_SECONDARY_USER=svc_settlement_exporter
SFG_SFTP_PASSWORD=CHANGE_ME_SFTP_PASSWORD
SFG_SECONDARY_KNOWN_HOSTS_PATH=/etc/sfg-exporter/keys/known_hosts
